# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (DATABASE_URL or POSTGRES_URL).
# Required in production: without it, contact-form submissions cannot be saved and the API returns 503.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tnova

# Comma-separated list of website origins allowed to call this API (no trailing slash).
# Leave unset in local development only.
CORS_ORIGINS=http://localhost:5173,https://www.tnovasolutions.com

# true  (default): site copy in src/db/data.js overwrites the database on startup.
# false: the database is the editable source; only missing sections are inserted.
CONTENT_SYNC=true

# Set true once your database provider's TLS certificate is trusted, to enforce full verification.
PGSSL_STRICT=false

# PORT=5000

# Optional: email alerts for new enquiries and job applications (the data is stored in the DB either way).
# SMTP_URL=smtps://user:password@smtp.example.com:465
# NOTIFY_EMAIL_TO=info@tnovasolutions.com
# NOTIFY_EMAIL_FROM=website@tnovasolutions.com

# Optional: enables GET /api/admin/submissions?type=contact|applications  (Authorization: Bearer <token>).
# Use a long random value, e.g. `openssl rand -hex 32`. Leave unset to keep the endpoint disabled.
# ADMIN_TOKEN=
